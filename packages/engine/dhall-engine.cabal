cabal-version:      2.4
name:               dhall-engine
version:            0.1.0.0
build-type:         Simple
synopsis:           Dhall WebAssembly engine bridge

executable dhall-engine
  main-is:          Bridge.hs
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:
      -O1
      -Wall
      -no-hs-main
      -optl-mexec-model=reactor
      -optl-Wl,--export=evaluate
      -optl-Wl,--export=typeCheck
      -optl-Wl,--export=describeType
  build-depends:
      aeson             >=2.0 && <2.4
    , base              >=4.18 && <4.23
    , bytestring        >=0.11
    , containers        >=0.6
    , dhall             >=1.42 && <1.43
    , filepath          >=1.4
    , ghc-experimental
    , text              >=2.0
